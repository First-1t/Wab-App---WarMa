PORT=5000

# ----- Admin: ล็อกอินด้วยอีเมลมหาวิทยาลัยผ่าน Google -----
# Client ID จาก Google Cloud Console — เว้นว่าง = ไม่ตรวจ (dev เท่านั้น, production จะปิดการแก้ไข)
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=kku.ac.th,kkumail.com
# ข้อความสุ่มยาว ๆ ใช้เซ็น session
AUTH_SECRET=

# ----- Admin: แจ้งเตือนอีเมลเมื่อมีความคิดเห็นใหม่ (เว้น SMTP_HOST = ไม่ส่งจริง) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:3000

# ----- Admin: ที่เก็บข้อมูล -----
# PostgreSQL เช่น Neon (ต้องใช้ตอน deploy) — เว้นว่าง = เก็บเป็นไฟล์ JSON ที่ backend/data/
DATABASE_URL=
