# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง

# ตอนพัฒนา: PostgreSQL ใน Docker (npm run dev เปิดให้อัตโนมัติจาก docker-compose.yml)
# ตอน deploy: Azure Database for PostgreSQL
DATABASE_URL="postgresql://warma:warma_dev@localhost:5432/warma?schema=public"

# พอร์ตของ backend API
PORT=3001

# Origin ของ frontend ที่อนุญาต (คั่นด้วย , ได้) — เว้นว่าง = อนุญาตทั้งหมด (dev เท่านั้น)
CORS_ORIGIN=http://localhost:3000

# ล็อกอินหน้าอาจารย์ (admin panel) ด้วยอีเมลมหาวิทยาลัยผ่าน Google
# GOOGLE_CLIENT_ID: สร้างที่ Google Cloud Console → APIs & Services → Credentials
#   → OAuth client ID (Web application) — เว้นว่าง = ไม่ตรวจ (dev เท่านั้น)
GOOGLE_CLIENT_ID=
# โดเมนอีเมลที่อนุญาตให้เข้าหน้าอาจารย์ (คั่นด้วย , ได้หลายโดเมน)
# kku.ac.th = อาจารย์/บุคลากร, kkumail.com = นักศึกษา
ALLOWED_EMAIL_DOMAIN=kku.ac.th,kkumail.com
# ข้อความสุ่มยาว ๆ ใช้เซ็น session (สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=

# Claude API key สำหรับฟีเจอร์ "AI อธิบายแบบง่าย" (ไม่ตั้ง = ปิดฟีเจอร์นี้)
ANTHROPIC_API_KEY=

# แจ้งเตือนทางอีเมลเมื่อมีความคิดเห็นใหม่ (เว้น SMTP_HOST ว่าง = ไม่ส่งเมลจริง แค่พิมพ์ log)
# ตัวอย่าง Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=อีเมล Gmail,
#   SMTP_PASS=App Password 16 หลัก (สร้างที่ myaccount.google.com/apppasswords — ต้องเปิด 2-Step Verification ก่อน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WarMa <your-account@gmail.com>"
# URL ของหน้าเว็บ ใช้ทำลิงก์ในอีเมล
APP_URL=http://localhost:3000
