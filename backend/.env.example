# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง

# Azure Database for PostgreSQL (หรือ PostgreSQL ในเครื่องตอนพัฒนา)
DATABASE_URL="postgresql://user:password@localhost:5432/warma?schema=public"

# พอร์ตของ backend API
PORT=3001

# Origin ของ frontend ที่อนุญาต (คั่นด้วย , ได้) — เว้นว่าง = อนุญาตทั้งหมด (dev เท่านั้น)
CORS_ORIGIN=http://localhost:3000

# รหัสสำหรับหน้าอาจารย์ (admin panel) — เว้นว่าง = ไม่ตรวจ (dev เท่านั้น)
ADMIN_KEY=

# Claude API key สำหรับฟีเจอร์ "AI อธิบายแบบง่าย" (ไม่ตั้ง = ปิดฟีเจอร์นี้)
ANTHROPIC_API_KEY=
